# Banco (docker compose up -d sobe este Postgres localmente)
DATABASE_URL="postgresql://lacid:lacid@localhost:5432/lacid?schema=public"

# Auth.js: gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_TRUST_HOST=true

# Usuario administrador criado pelo seed (troque a senha!)
